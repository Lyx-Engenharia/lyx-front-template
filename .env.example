NEXT_PUBLIC_API_URL=http://localhost:3000

# Slug da org deste sistema no monolito (entrada do catálogo em
# lyx-monolith/src/modules/sistemas/sistemas.service.ts). Só entra quem tem
# membership ativa nela, e é a org que o dashboard ativa na sessão.
NEXT_PUBLIC_ORG_SLUG=meu-sistema

# Hub de sistemas: o login é dele (SSO), e é o link da tela "sem acesso".
# Em produção: https://hub.lyxai.com.br. A origin deste front precisa estar na
# allowlist de redirect do Hub (lyx-hub-front/src/lib/login-redirect.ts) e no
# TRUSTED_ORIGINS do monolito.
NEXT_PUBLIC_HUB_URL=http://localhost:3002
